<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
            http://maven.apache.org/POM/4.0.0
            https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.ren1kron</groupId>
    <artifactId>lab3</artifactId>
    <version>хуй</version>
    <packaging>war</packaging>
    <name>web3</name>

    <!-- Подтягиваем properties из внешнего файла -->
    <properties>
        <config.file>config.properties</config.file>

        <lab3.version>${project.version}</lab3.version>

        <!-- Для javadoc, чтобы включать doc в jar и т.д. -->
        <maven.javadoc.failOnError>false</maven.javadoc.failOnError>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Jakarta EE API (scope provided, т.к. контейнер сервера приложений это даст) -->
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-web-api</artifactId>
            <version>10.0.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- PrimeFaces -->
        <dependency>
            <groupId>org.primefaces</groupId>
            <artifactId>primefaces</artifactId>
            <version>14.0.6</version>
            <classifier>jakarta</classifier>
        </dependency>
        <!-- PrimeFaces Themes -->
        <dependency>
            <groupId>org.primefaces.themes</groupId>
            <artifactId>all-themes</artifactId>
            <version>1.1.0</version>
        </dependency>
        <!-- PrimeFlex -->
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>primeflex</artifactId>
            <version>3.3.1</version>
        </dependency>
        <!-- PrimeIcons -->
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>primeicons</artifactId>
            <version>7.0.0</version>
        </dependency>

        <!-- Hibernate ORM -->
        <dependency>
            <groupId>org.hibernate</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>6.6.1.Final</version>
        </dependency>

        <!-- PostgreSQL JDBC Driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.4</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Logback (SLF4J) -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.3.12</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.34</version>
            <scope>provided</scope>
        </dependency>

        <!-- JUnit 5 (JUnit Jupiter) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Фаза resources в Maven сама копирует ресурсы из src/main/resources,
             Но чтобы использовать файл config.properties как фильтруемый,
             можно настроить resource-фильтрацию: -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
            <!-- Можно добавить внешние ресурсы, например config.properties из корня,
                 и тоже прогонять через фильтр, если нужно подставлять какие-то переменные. -->
            <resource>
                <directory>.</directory>
                <includes>
                    <include>config.properties</include>
                </includes>
                <filtering>true</filtering>
            </resource>
        </resources>

        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.34</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- compile и build (package) -->
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.10.1</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>

            <!-- clean -->
            <plugin>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.1.0</version>
            </plugin>

            <!-- test -->
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.0.0-M7</version>
            </plugin>

            <!-- doc -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <SHA1>${sha1}</SHA1>
                            <MD5>${md5}</MD5>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>generate-hashes</id>
                        <phase>package</phase>
                        <configuration>
                            <target>
                                <checksum file="${project.build.directory}/${project.build.finalName}.jar"
                                          property="sha1"
                                          algorithm="SHA-1"/>
                                <checksum file="${project.build.directory}/${project.build.finalName}.jar"
                                          property="md5"
                                          algorithm="MD5"/>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>



            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>doc</id>
                        <phase>none</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <!-- вычисление MD5 и SHA-1 для war -->
                                <checksum file="${project.build.directory}/${project.build.finalName}.war"
                                          property="war.checksum"
                                          algorithm="MD5"/>
                                <checksum file="${project.build.directory}/${project.build.finalName}.war"
                                          property="war.sha1"
                                          algorithm="SHA-1"/>

                                <!-- добавление этих значений в MANIFEST.MF через задачу <war update="true"> -->
                                <war destfile="${project.build.directory}/${project.build.finalName}.war" update="true">
                                    <manifest>
                                        <attribute name="MD5" value="${war.checksum}"/>
                                        <attribute name="SHA-1" value="${war.sha1}"/>
                                    </manifest>
                                </war>

                                <!-- генерация Javadoc -->
                                <mkdir dir="${project.build.directory}/doc"/>
                                <javadoc sourcepath="${project.build.sourceDirectory}"
                                         destdir="${project.build.directory}/doc"
                                         packagenames="org.ren1kron.**"
                                         classpath="${project.build.outputDirectory}">
                                    <doctitle>${project.name} API</doctitle>
                                </javadoc>

                                <!-- добавление сгенерированного Javadoc в тот же war (update="true") -->
                                <jar destfile="${project.build.directory}/${project.build.finalName}.war" update="true">
                                    <fileset dir="${project.build.directory}/doc"/>
                                </jar>

                                <echo message="Done: MD5, SHA1, Javadoc added to war file"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- maven-jar-plugin: чтобы прописать Main-Class и прочие поля в MANIFEST.MF -->
            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.2.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            <addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
                            <mainClass>${main.class}</mainClass>
                            <manifestEntries>
                                <Implementation-Version>${lab3.version}</Implementation-Version>
                                <!-- Прочие поля, например MD5/SHA1,
                                     хотя проще это делать в отдельном Jar task или с помощью shade-plugin,
                                     тут, для наглядности, просто укажем. -->
                                <MD5-Checksum>${lab3.checksum}</MD5-Checksum>
                                <SHA1-Checksum>${lab3.checksum.sha1}</SHA1-Checksum>
                            </manifestEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!-- Для javadoc: чтобы собрать документацию и по желанию включить в final jar или собрать javadoc.jar -->
            <plugin>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal> <!-- Собирает javadoc.jar -->
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <!-- Профили (если нужно активировать какие-то задачи только при определённых условиях и т.д.) -->
    <profiles>
        <!-- Например, профиль для alt-сборки -->
        <profile>
            <id>alt-build</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <!-- Можно снова сослаться на antrun@alt или просто вызвать mvn antrun:run@alt -->
                </plugins>
            </build>
        </profile>
    </profiles>

</project>

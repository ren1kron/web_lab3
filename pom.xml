<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
            http://maven.apache.org/POM/4.0.0
            https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.ren1kron</groupId>
    <artifactId>lab3</artifactId>
    <version>хуй</version>
    <packaging>war</packaging>
    <name>web3</name>

    <!-- Подтягиваем properties из внешнего файла -->
    <properties>
        <config.file>config.properties</config.file>

        <lab3.version>${project.version}</lab3.version>

        <!-- Для javadoc, чтобы включать doc в jar и т.д. -->
        <maven.javadoc.failOnError>false</maven.javadoc.failOnError>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Jakarta EE API (scope provided, т.к. контейнер сервера приложений это даст) -->
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-web-api</artifactId>
            <version>10.0.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- PrimeFaces -->
        <dependency>
            <groupId>org.primefaces</groupId>
            <artifactId>primefaces</artifactId>
            <version>14.0.6</version>
            <classifier>jakarta</classifier>
        </dependency>
        <!-- PrimeFaces Themes -->
        <dependency>
            <groupId>org.primefaces.themes</groupId>
            <artifactId>all-themes</artifactId>
            <version>1.1.0</version>
        </dependency>
        <!-- PrimeFlex -->
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>primeflex</artifactId>
            <version>3.3.1</version>
        </dependency>
        <!-- PrimeIcons -->
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>primeicons</artifactId>
            <version>7.0.0</version>
        </dependency>

        <!-- Hibernate ORM -->
        <dependency>
            <groupId>org.hibernate</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>6.6.1.Final</version>
        </dependency>

        <!-- PostgreSQL JDBC Driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.4</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Logback (SLF4J) -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.3.12</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.34</version>
            <scope>provided</scope>
        </dependency>

        <!-- JUnit 5 (JUnit Jupiter) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Фаза resources в Maven сама копирует ресурсы из src/main/resources,
             Но чтобы использовать файл config.properties как фильтруемый,
             можно настроить resource-фильтрацию: -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
            <!-- Можно добавить внешние ресурсы, например config.properties из корня,
                 и тоже прогонять через фильтр, если нужно подставлять какие-то переменные. -->
            <resource>
                <directory>.</directory>
                <includes>
                    <include>config.properties</include>
                </includes>
                <filtering>true</filtering>
            </resource>
        </resources>

        <plugins>

            <!-- (Задачи 1 и 2) Стандартная компиляция и упаковка в war:
                 mvn compile, mvn package
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.3.2</version>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                    <!-- При необходимости настройте сборку war -->
                </configuration>
            </plugin>

            <!-- clean -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>



            <!-- (Задача 5) Перемещение собранного проекта на сервер по SCP -->
            <plugin>
                <groupId>org.apache.maven.wagon</groupId>
                <artifactId>wagon-maven-plugin</artifactId>
                <version>1.0</version>
                <executions>
                    <execution>
                        <id>scp-deploy</id>
                        <!-- Допустим, хотим делать это после package -->
                        <phase>install</phase>
                        <goals>
                            <goal>upload</goal>
                        </goals>
                        <configuration>
                            <serverId>scp-host</serverId>
                            <fromFile>${project.build.directory}/${project.build.finalName}.war</fromFile>
                            <url>scp://${scp.host}${scp.path}</url>
                        </configuration>
                    </execution>
                </executions>
            </plugin>



            <!-- (Задача 7) Добавление MD5 и SHA-1 в MANIFEST.MF, генерация javadoc и
                 добавление в архив. Чек-суммы в MANIFEST - можно с помощью antrun и ant-конструкций:
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.4.0</version>
                <executions>
                    <execution>
                        <id>generate-javadoc</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>




            <!-- (Задача 9) Воспроизведение музыки после сборки (фаза package).
                 Можно воспроизвести через системную команду (exec).
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>play-music</id>
                        <phase>package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>java</executable>
                            <arguments>
                                <!-- Или можно вызвать любую внешнюю программу-плеер -->
                                <argument>-cp</argument>
                                <argument>${project.build.directory}/classes</argument>
                                <argument>org.example.tools.MusicPlayer</argument>
                                <argument>${music.path}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>



            <!-- (Задача 11) Проверка изменений в рабочей копии, если они не касаются заданных
                 классов - commit. Аналогично, либо maven-scm-plugin, либо скрипты через antrun/exec.
            -->
            <plugin>
                <groupId>org.apache.maven.scm</groupId>
                <artifactId>maven-scm-plugin</artifactId>
                <version>1.11.3</version>
                <!-- Настройка SCM, если используем git. Либо опять же через exec. -->
            </plugin>

            <!-- (Задача 12) Если проект не компилируется (compile) - откат на предыдущую версию,
                 пока не найдём рабочую. Если нет - формируем diff. Снова скрипты,
                 содержащие логику по git checkout, mvn compile, git diff...
            -->
            <!-- (Задача 13) Создание альтернативной версии с переименованием классов и переменных.
                 Обычно требует либо написания отдельного тулзинга (где-то в Java/ASM/JDT),
                 либо утилит, вызываемых через exec/antrun.
            -->
            <!-- (Задача 14) Если тесты прошли, сохранить отчёт junit (Surefire уже пишет в target/surefire-reports),
                 закоммитить в git.
            -->
            <!-- (Задача 15) Сборка и запуск в альтернативных окружениях (разных версиях Java и аргументах).
                 Можно использовать Maven Toolchains Plugin, либо несколько профилей с разными настройками
                 compiler, либо опять же exec.
            -->


            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>

                    <!-- (Задача 4) "Сначала package, потом test" -->
                    <execution>
                        <id>custom-test-after-package</id>
                        <!-- Запустим на фазе verify -->
                        <phase>verify</phase>
                        <configuration>
                            <target>
                                <echo>=== Выполняем: mvn package ===</echo>
                                <exec executable="mvn">
                                    <arg value="package"/>
                                </exec>
                                <echo>=== Выполняем: mvn test ===</echo>
                                <exec executable="mvn">
                                    <arg value="test"/>
                                </exec>
                            </target>
                        </configuration>
                        <goals>
                            <!-- Вместо <goal>execute</goal> указываем <goal>run</goal> -->
                            <goal>run</goal>
                        </goals>
                    </execution>

                    <!-- (Задача 6) Преобразование native2ascii -->
                    <execution>
                        <id>native2ascii-files</id>
                        <!-- Пусть эта задача будет на фазе process-resources -->
                        <phase>process-resources</phase>
                        <configuration>
                            <target>
                                <echo>=== Выполняем native2ascii для локализационных файлов ===</echo>
                                <mkdir dir="${project.build.directory}/native2ascii"/>
                                <native2ascii
                                        srcdir="${project.basedir}/src/main/resources/i18n"
                                        destdir="${project.build.directory}/native2ascii"
                                        encoding="UTF-8" />
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>

                    <!-- (Задача 8) Валидация XML -->
                    <execution>
                        <id>validate-xml</id>
                        <phase>verify</phase>
                        <configuration>
                            <target>
                                <echo>=== Валидация XML ===</echo>
                                <xmlvalidate lenient="false" haltOnError="true">
                                    <fileset dir="${project.basedir}/src/main/resources"
                                             includes="**/*.xml"/>
                                </xmlvalidate>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>

                    <!-- (Задача 10) Сборка двух предыдущих ревизий git -->
                    <execution>
                        <id>build-previous-revs</id>
                        <phase>verify</phase>
                        <configuration>
                            <target>
                                <echo>=== Получаем 2 предыдущие ревизии GIT ===</echo>
                                <!-- Здесь блоки <exec> для git checkout HEAD~1, mvn package и т.д. -->
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>

                    <!-- И т.д. при необходимости можно добавить новые executions -->
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Профили (если нужно активировать какие-то задачи только при определённых условиях и т.д.) -->
    <profiles>
        <!-- Например, профиль для alt-сборки -->
        <profile>
            <id>alt-build</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <!-- Можно снова сослаться на antrun@alt или просто вызвать mvn antrun:run@alt -->
                </plugins>
            </build>
        </profile>
    </profiles>

</project>

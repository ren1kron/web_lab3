<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
            http://maven.apache.org/POM/4.0.0
            https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.ren1kron</groupId>
    <artifactId>lab3</artifactId>
    <version>хуй</version>
    <packaging>war</packaging>
    <name>web3</name>

    <!-- Подтягиваем properties из внешнего файла -->
    <properties>
        <config.file>config.properties</config.file>

        <lab3.version>${project.version}</lab3.version>

        <!-- Для javadoc, чтобы включать doc в jar и т.д. -->
        <maven.javadoc.failOnError>false</maven.javadoc.failOnError>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Jakarta EE API (scope provided, т.к. контейнер сервера приложений это даст) -->
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-web-api</artifactId>
            <version>10.0.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- PrimeFaces -->
        <dependency>
            <groupId>org.primefaces</groupId>
            <artifactId>primefaces</artifactId>
            <version>14.0.6</version>
            <classifier>jakarta</classifier>
        </dependency>
        <!-- PrimeFaces Themes -->
        <dependency>
            <groupId>org.primefaces.themes</groupId>
            <artifactId>all-themes</artifactId>
            <version>1.1.0</version>
        </dependency>
        <!-- PrimeFlex -->
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>primeflex</artifactId>
            <version>3.3.1</version>
        </dependency>
        <!-- PrimeIcons -->
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>primeicons</artifactId>
            <version>7.0.0</version>
        </dependency>

        <!-- Hibernate ORM -->
        <dependency>
            <groupId>org.hibernate</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>6.6.1.Final</version>
        </dependency>

        <!-- PostgreSQL JDBC Driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.4</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Logback (SLF4J) -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.3.12</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.34</version>
            <scope>provided</scope>
        </dependency>

        <!-- JUnit 5 (JUnit Jupiter) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Фаза resources в Maven сама копирует ресурсы из src/main/resources,
             Но чтобы использовать файл config.properties как фильтруемый,
             можно настроить resource-фильтрацию: -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
            <!-- Можно добавить внешние ресурсы, например config.properties из корня,
                 и тоже прогонять через фильтр, если нужно подставлять какие-то переменные. -->
            <resource>
                <directory>.</directory>
                <includes>
                    <include>config.properties</include>
                </includes>
                <filtering>true</filtering>
            </resource>
        </resources>

        <plugins>

            <!-- compile и build (package) -->
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.10.1</version>
                <configuration>
                    <source>11</source>
                    <target>11</target>
                </configuration>
            </plugin>

            <!-- clean -->
            <plugin>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.1.0</version>
            </plugin>

            <!-- test -->
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.0.0-M7</version>
            </plugin>

            <!-- scp — пример через antrun (реально лучше смотреть wagon-maven-plugin).
                 Допустим, хотим выполнять "mvn scp:scp" или "mvn antrun:run@scp" -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <!-- Создадим отдельную конфигурацию для scp,
                         привяжем к произвольной фазе site (или install)
                         ИЛИ запускаем вручную через goal antrun:run@scp -->
                    <execution>
                        <id>scp</id>
                        <phase>deploy</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <antcall target="package"/>
                                <scp todir="${scp.server}" trust="true" verbose="true">
                                    <fileset dir="${project.build.directory}">
                                        <include name="${project.build.finalName}.war"/>
                                    </fileset>
                                </scp>
                            </target>
                        </configuration>
                    </execution>

                    <!-- 6) native2ascii: аналогично -->
                    <execution>
                        <id>native2ascii</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <!-- Пример Ant-задачи native2ascii
                                     (на практике возможно проще использовать mojohaus native2ascii-maven-plugin) -->
                                <native2ascii src="${basedir}/src/main/resources/locales"
                                              dest="${project.build.directory}/converted-locales"
                                              encoding="UTF-8" extension=".properties"/>
                            </target>
                        </configuration>
                    </execution>

                    <!-- 7) doc: Добавляем MD5 и SHA1 в MANIFEST, генерируем javadoc и упаковываем в jar -->
                    <execution>
                        <id>doc</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <!-- Генерация MD5/SHA1 для jar -->
                                <checksum file="${project.build.directory}/${project.build.finalName}.jar"
                                          property="lab3.checksum"
                                          fileext=".md5"/>
                                <checksum file="${project.build.directory}/${project.build.finalName}.jar"
                                          algorithm="SHA1"
                                          property="lab3.checksum.sha1"
                                          fileext=".sha1"/>
                                <!-- Запись в MANIFEST дополнительной информации о MD5/SHA1 -->
                                <echo message="MD5: ${lab3.checksum}"/>
                                <echo message="SHA1: ${lab3.checksum.sha1}"/>
                                <!-- Прямого Ant-тasks для добавления в MANIFEST нет, но можно
                                     либо пересобрать Jar c помощью <jar> task,
                                     либо использовать настройки maven-jar-plugin (см. ниже). -->
                            </target>
                        </configuration>
                    </execution>

                    <!-- 8) xml: Проверка/валидация XML-файлов -->
                    <execution>
                        <id>validate-xml</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <xmlvalidate lenient="false">
                                    <fileset dir="${basedir}/src/main/resources">
                                        <include name="**/*.xml"/>
                                    </fileset>
                                </xmlvalidate>
                            </target>
                        </configuration>
                    </execution>

                    <!-- 9) music — воспроизведение музыки по завершению сборки (например, после package) -->
                    <execution>
                        <id>music</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <echo message="Playing music..."/>
                                <exec executable="sh">
                                    <arg value="-c"/>
                                    <arg line="${music.cmd}"/>
                                </exec>
                            </target>
                        </configuration>
                    </execution>

                    <!-- 10) team — получение 2 предыдущих ревизий из git, их сборка, упаковка jar в zip -->
                    <execution>
                        <id>team</id>
                        <phase>none</phase> <!-- Запуск вручную: mvn antrun:run@team -->
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <echo message="Team task: checkout 2 prev revisions, build them, zip jars"/>
                                <!-- Здесь можно использовать <exec> для git checkout <rev>, затем mvn package -->
                                <!-- Для зипования: -->
                                <zip destfile="${project.build.directory}/team_jars.zip">
                                    <fileset dir="${project.build.directory}">
                                        <include name="*.jar"/>
                                    </fileset>
                                </zip>
                            </target>
                        </configuration>
                    </execution>

                    <!-- 11) diff — проверка изменений, commit в git при необходимости -->
                    <execution>
                        <id>diff</id>
                        <phase>none</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <echo message="Diff task: проверяем, что менялись не критичные файлы..."/>
                                <!-- В реальности: git status / git diff, затем проверка exclude-файлов
                                     (excluded.files из config.properties) -->
                                <!-- Если всё ок, то git commit -->
                            </target>
                        </configuration>
                    </execution>

                    <!-- 12) history — при неудачной сборке откатываемся по ревизиям... -->
                    <execution>
                        <id>history</id>
                        <phase>none</phase> <!-- вручную или через profile -->
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <!-- Логика: пробуем mvn compile, если fail — git checkout HEAD~1, повторяем -->
                                <echo message="History task: if compile fails, revert to previous revision..."/>
                            </target>
                        </configuration>
                    </execution>

                    <!-- 13) alt — создание альтернативной версии программы, замена имен (replace) -->
                    <execution>
                        <id>alt</id>
                        <phase>none</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <echo message="Creating alternative version..."/>
                                <replaceregexp match="${replace.old.name}" replace="${replace.new.name}" flags="g">
                                    <fileset dir="src/main/java">
                                        <include name="**/*.java"/>
                                    </fileset>
                                </replaceregexp>
                                <!-- После этого запускаем сборку (mvn package) -->
                                <antcall target="package"/>
                            </target>
                        </configuration>
                    </execution>

                    <!-- 14) report — если тесты прошли, добавляем отчёт в SVN и делаем commit -->
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <echo message="Report task: checking test results..."/>
                                <!-- Примерно: проверить наличие surefire-reports/*.xml => svn add => svn commit -->
                            </target>
                        </configuration>
                    </execution>

                    <!-- 15) env — сборка и запуск программы в альтернативных окружениях (javaVersion, jvmArgs) -->
                    <execution>
                        <id>env</id>
                        <phase>none</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <echo message="Env task: building/running under different Java versions..."/>
                                <!-- Здесь можно, например, перебрать список версий, запускать командой:
                                     /usr/lib/jvm/java-${version}/bin/java ${env.jvmArgs} -jar ...
                                     И проверять результат -->
                                <!-- Также можно подключить maven-toolchains-plugin,
                                     если надо полноценно автоматически собирать под разные Java. -->
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- maven-jar-plugin: чтобы прописать Main-Class и прочие поля в MANIFEST.MF -->
            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.2.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            <addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
                            <mainClass>${main.class}</mainClass>
                            <manifestEntries>
                                <Implementation-Version>${lab3.version}</Implementation-Version>
                                <!-- Прочие поля, например MD5/SHA1,
                                     хотя проще это делать в отдельном Jar task или с помощью shade-plugin,
                                     тут, для наглядности, просто укажем. -->
                                <MD5-Checksum>${lab3.checksum}</MD5-Checksum>
                                <SHA1-Checksum>${lab3.checksum.sha1}</SHA1-Checksum>
                            </manifestEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!-- Для javadoc: чтобы собрать документацию и по желанию включить в final jar или собрать javadoc.jar -->
            <plugin>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal> <!-- Собирает javadoc.jar -->
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <!-- Профили (если нужно активировать какие-то задачи только при определённых условиях и т.д.) -->
    <profiles>
        <!-- Например, профиль для alt-сборки -->
        <profile>
            <id>alt-build</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <!-- Можно снова сослаться на antrun@alt или просто вызвать mvn antrun:run@alt -->
                </plugins>
            </build>
        </profile>
    </profiles>

</project>

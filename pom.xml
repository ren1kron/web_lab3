                    <!-- Задача 6. native2ascii -->
                    <!-- работает -->
                    <execution>
                        <id>native2ascii</id>
                        <phase>process-resources</phase>
                        <configuration>
                            <target>
                                <delete dir="${project.build.directory}/resources/resources-native"/>
                                <mkdir dir="${project.build.directory}/resources/resources-native"/>
                                <native2ascii src="${project.basedir}/src/main/resources"
                                              dest="${project.build.directory}/resources/resources-native"
                                              includes="**/*.properties"
                                              encoding="ISO-8859-1"
                                              reverse="false"/>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>

                    <!-- Задача 8. native2ascii -->
                    <!-- работает -->
                    <execution>
                        <id>validate-xml</id>
                        <phase>validate</phase>
                        <configuration>
                            <target>
                                <xmlvalidate>
                                    <fileset dir="${project.basedir}/src/main/resources">
                                        <include name="**/*.xml"/>
                                    </fileset>
                                    <fileset dir="${project.basedir}/src/main/webapp">
                                        <include name="**/*.xml"/>
                                    </fileset>
                                    <attribute name="http://xml.org/sax/features/validation" value="true"/>
                                    <attribute name="http://apache.org/xml/features/validation/schema"  value="true"/>
                                    <attribute name="http://xml.org/sax/features/namespaces" value="true"/>
                                </xmlvalidate>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>

                    <!-- Задача 10. team -->
                    <!-- вроде работает -->
                    <execution>
                        <id>build-previous-revisions</id>
                        <phase>site</phase>
                        <configuration>
                            <target>
                                <echo>=== Получаем 2 предыдущие ревизии GIT ===</echo>
                                <exec executable="git">
                                    <arg value="stash"/>
                                </exec>

                                <exec executable="git">
                                    <arg value="checkout"/>
                                    <arg value="HEAD~1"/>
                                </exec>
                                <exec executable="mvn">
                                    <arg value="package"/>
                                </exec>
                                <copy file="${project.build.directory}/${project.build.finalName}.war"
                                      tofile="${project.build.directory}/${project.build.finalName}.rev1.war"/>
                                <!-- Аналогичные действия для второй ревизии -->
                                <exec executable="git">
                                    <arg value="checkout"/>
                                    <arg value="HEAD~1"/>
                                </exec>
                                <exec executable="mvn">
                                    <arg value="package"/>
                                </exec>
                                <copy file="${project.build.directory}/${project.build.finalName}.war"
                                      tofile="${project.build.directory}/${project.build.finalName}.rev2.war"/>

                                <!-- Возвращаемся на основную ветку -->
                                <exec executable="git">
                                    <arg value="checkout"/>
                                    <arg value="opi3"/>
                                </exec>
                                <!-- Упаковка в zip -->
                                <zip destfile="${project.build.directory}/team_builds.zip">
                                    <fileset dir="${project.build.directory}">
                                        <include name="*.rev1.war"/>
                                        <include name="*.rev2.war"/>
                                    </fileset>
                                </zip>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>

                    <!-- Задача 11. diff-->
                    <execution>
                        <id>check-and-commit</id>
                        <phase>verify</phase>
                        <configuration>
                            <target>
                                <!-- Подключаем ant-contrib -->
                                <taskdef resource="net/sf/antcontrib/antcontrib.properties"
                                         classpathref="maven.plugin.classpath"/>

                                <!-- 1) Проверяем, какие файлы изменены (git status или git diff) -->
                                <exec executable="git">
                                    <arg value="diff"/>
                                    <arg value="--name-only"/>
                                    <arg value="HEAD"/>
                                    <!-- Сохраняем вывод в свойство -->
                                    <redirector outputproperty="git.diff.files"/>
                                </exec>
                                <echo message="Changed files: ${git.diff.files}"/>

                                <!-- 2) Если в списке нет критичных классов (из build.properties: diff.critical.classes),
                                       то делаем commit. Иначе - пропускаем. -->
                                <condition property="do.commit">
                                    <not>
                                        <contains string="${git.diff.files}" substring="org/ren1kron/FacesConfiguration.java"/>
                                    </not>
                                </condition>
                                <echo message="do.commit: ${do.commit}"/>

                                <if>
                                    <equals arg1="${do.commit}" arg2="true"/>
                                    <then>
                                        <echo message="Commit changes..."/>
                                        <exec executable="git">
                                            <arg value="commit"/>
                                            <arg value="-a"/>
                                            <arg value="-m"/>
                                            <arg value="Automatic commit"/>
                                        </exec>
                                        <!--                    <exec executable="git">-->
                                        <!--                        <arg value="push"/>-->
                                        <!--                    </exec>-->
                                    </then>
                                    <else>
                                        <echo message="Changes affect critical classes. Commit skipped."/>
                                    </else>
                                </if>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>



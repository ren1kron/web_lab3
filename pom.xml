            <artifactId>primeicons</artifactId>
            <version>7.0.0</version>
        </dependency>

        <!-- Hibernate ORM -->
        <dependency>
            <groupId>org.hibernate</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>6.6.1.Final</version>
        </dependency>

        <!-- PostgreSQL JDBC Driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.4</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Logback (SLF4J) -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.3.12</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.34</version>
            <scope>provided</scope>
        </dependency>

        <!-- JUnit 5 (JUnit Jupiter) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Фаза resources в Maven сама копирует ресурсы из src/main/resources,
             Но чтобы использовать файл config.properties как фильтруемый,
             можно настроить resource-фильтрацию: -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
            <!-- Можно добавить внешние ресурсы, например config.properties из корня,
                 и тоже прогонять через фильтр, если нужно подставлять какие-то переменные. -->
            <resource>
                <directory>.</directory>
                <includes>
                    <include>config.properties</include>
                </includes>
                <filtering>true</filtering>
            </resource>
        </resources>

        <plugins>
            <!-- compile + Процессор аннотаций lombok и версия java -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.34</version>
                        </path>
                    </annotationProcessorPaths>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>

            <!-- build + test (package) -->
            <!-- для запуска просто build, без тестов: -->
            <!-- mvn package -DskipTests -Dmaven.test.skip=true -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.3.2</version>
            </plugin>

            <!-- clean -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>



            <!-- (Задача 5) Перемещение собранного проекта на сервер по SCP -->
            <!-- работает -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>wagon-maven-plugin</artifactId>
                <version>2.0.2</version>
                <executions>
                    <execution>
                        <id>scp-deploy</id>
                        <phase>install</phase>
                        <goals>
                            <goal>upload</goal>
                        </goals>
                        <configuration>
                            <serverId>helios</serverId>
                            <fromDir>${project.build.directory}/</fromDir>
                            <includes>${project.build.finalName}.war</includes>
                            <url>scp://s409411@helios.cs.ifmo.ru:2222/home/studs/s409411/zalupa</url>
                        </configuration>
                    </execution>
                </executions>
            </plugin>



            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <!-- Задача 6. native2ascii -->
                    <!-- работает -->
                    <execution>
                        <id>native2ascii</id>
                        <phase>process-resources</phase>
                        <configuration>
                            <target>
                                <delete dir="${project.build.directory}/resources/resources-native"/>
                                <mkdir dir="${project.build.directory}/resources/resources-native"/>
                                <native2ascii src="${project.basedir}/src/main/resources"
                                              dest="${project.build.directory}/resources/resources-native"
                                              includes="**/*.properties"
                                              encoding="ISO-8859-1"
                                              reverse="false"/>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>

                    <!-- Задача 8. native2ascii -->
                    <!-- работает -->
                    <execution>
                        <id>validate-xml</id>
                        <phase>validate</phase>
                        <configuration>
                            <target>
                                <xmlvalidate>
                                    <fileset dir="${project.basedir}/src/main/resources">
                                        <include name="**/*.xml"/>
                                    </fileset>
                                    <fileset dir="${project.basedir}/src/main/webapp">
                                        <include name="**/*.xml"/>
                                    </fileset>
                                    <attribute name="http://xml.org/sax/features/validation" value="true"/>
                                    <attribute name="http://apache.org/xml/features/validation/schema"  value="true"/>
                                    <attribute name="http://xml.org/sax/features/namespaces" value="true"/>
                                </xmlvalidate>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>

                    <!-- Задача 10. team -->
                    <!-- вроде работает -->
                    <execution>
                        <id>build-previous-revisions</id>
                        <phase>site</phase>
                        <configuration>
                            <target>
                                <echo>=== Получаем 2 предыдущие ревизии GIT ===</echo>
                                <exec executable="git">
                                    <arg value="stash"/>
                                </exec>

                                <exec executable="git">
                                    <arg value="checkout"/>
                                    <arg value="HEAD~1"/>
                                </exec>
                                <exec executable="mvn">
                                    <arg value="package"/>
                                </exec>
                                <copy file="${project.build.directory}/${project.build.finalName}.war"
                                      tofile="${project.build.directory}/${project.build.finalName}.rev1.war"/>
                                <!-- Аналогичные действия для второй ревизии -->
                                <exec executable="git">
                                    <arg value="checkout"/>
                                    <arg value="HEAD~1"/>
                                </exec>
                                <exec executable="mvn">
                                    <arg value="package"/>
                                </exec>
                                <copy file="${project.build.directory}/${project.build.finalName}.war"
                                      tofile="${project.build.directory}/${project.build.finalName}.rev2.war"/>

                                <!-- Возвращаемся на основную ветку -->
                                <exec executable="git">
                                    <arg value="checkout"/>
                                    <arg value="opi3"/>
                                </exec>
                                <!-- Упаковка в zip -->
                                <zip destfile="${project.build.directory}/team_builds.zip">
                                    <fileset dir="${project.build.directory}">
                                        <include name="*.rev1.war"/>
                                        <include name="*.rev2.war"/>
                                    </fileset>
                                </zip>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>

                    <!-- Задача 13. alt-->
                    <!-- создаёт альтернативную версию программы с измененными именами переменных и классов
                    и упаковывает её в war-архив. Для создания war-архива использует цель package. -->
                    <execution>
                        <id>alt</id>
                        <configuration>
                            <target>
                                <!-- Копируем исходники -->
                                <mkdir dir="${project.build.directory}/alt-src"/>
                                <copy todir="${project.build.directory}/alt-src">
                                    <fileset dir="src/main/java"/>
                                </copy>
                                <!-- Замена имён в коде -->
                                <replaceregexp flags="g" byline="true"
                                               match="${replace.regex.oldName}"
                                               replace="${replace.regex.newName}">
                                    <fileset dir="${project.build.directory}/alt-src">
                                        <include name="**/*.java"/>
                                    </fileset>
                                </replaceregexp>
                                <!-- Компиляция альтернативной версии -->
                                <mkdir dir="${project.build.directory}/alt-classes"/>
                                <javac srcdir="${project.build.directory}/alt-src"
                                       destdir="${project.build.directory}/alt-classes"
                                       includeantruntime="false"
                                       source="${compile.version}"
                                       target="${compile.version}">
                                    <classpath>
                                        <path refid="maven.dependency.classpath"/>
                                    </classpath>
                                </javac>
                                <!-- Упаковка alt-версии в WAR -->
                                <war destfile="${project.build.directory}/${project.build.finalName}-alt.war"
                                     webxml="src/main/webapp/WEB-INF/web.xml">
                                    <classes dir="${project.build.directory}/alt-classes"/>
                                    <fileset dir="src/main/webapp"/>
                                </war>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>



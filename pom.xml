            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <!-- Задача 9. music - Воспроизведение музыки после сборки -->
                    <!-- работает -->
                    <execution>
                        <id>play-gif-music</id>
                        <phase>package</phase>

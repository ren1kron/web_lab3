<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
            http://maven.apache.org/POM/4.0.0
            https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.ren1kron</groupId>
    <artifactId>lab3</artifactId>
    <version>хуй</version>
    <packaging>war</packaging>
    <name>web3</name>

    <!-- Подтягиваем properties из внешнего файла -->
    <properties>
        <config.file>config.properties</config.file>

        <lab3.version>${project.version}</lab3.version>
        <compile.version>17</compile.version>

        <!-- Для javadoc, чтобы включать doc в jar и т.д. -->
        <maven.javadoc.failOnError>false</maven.javadoc.failOnError>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- для alt -->
        <replace.regex.oldName>org.ren1kron</replace.regex.oldName>
        <replace.regex.newName>org.Kostya666</replace.regex.newName>

        <!-- для env -->
        <env.java.version>17</env.java.version>
        <env.vm.args>-Xmx512m</env.vm.args>
        <tomcat.port>8080</tomcat.port>
    </properties>

    <dependencies>
        <!-- Jakarta EE API (scope provided, т.к. контейнер сервера приложений это даст) -->
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-web-api</artifactId>
            <version>10.0.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- Servlet API for compilation -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>5.0.0</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.glassfish</groupId>
            <artifactId>jakarta.faces</artifactId>
            <version>4.0.2</version>
        </dependency>

        <!-- Зависимость с реализацией Cargo для Tomcat 10 (включает код интеграции контейнера) -->
        <dependency>
            <groupId>org.codehaus.cargo</groupId>
            <artifactId>cargo-core-uberjar</artifactId>
            <version>1.10.19</version>
        </dependency>
        <!-- Библиотека Apache Commons Daemon, необходимая для запуска Tomcat 10 внутри Maven -->
        <dependency>
            <groupId>commons-daemon</groupId>
            <artifactId>commons-daemon</artifactId>
            <version>1.2.4</version>  <!-- Версия, совместимая с Tomcat 10 (Apache Commons Daemon) -->
        </dependency>


        <!-- PrimeFaces -->
        <dependency>
            <groupId>org.primefaces</groupId>
            <artifactId>primefaces</artifactId>
            <version>14.0.6</version>
            <classifier>jakarta</classifier>
        </dependency>
        <!-- PrimeFaces Themes -->
        <dependency>
            <groupId>org.primefaces.themes</groupId>
            <artifactId>all-themes</artifactId>
            <version>1.1.0</version>
        </dependency>
        <!-- PrimeFlex -->
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>primeflex</artifactId>
            <version>3.3.1</version>
        </dependency>
        <!-- PrimeIcons -->
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>primeicons</artifactId>
            <version>7.0.0</version>
        </dependency>

        <!-- Hibernate ORM -->
        <dependency>
            <groupId>org.hibernate</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>6.6.1.Final</version>
        </dependency>

        <!-- PostgreSQL JDBC Driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.4</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Logback (SLF4J) -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.3.12</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.34</version>
            <scope>provided</scope>
        </dependency>

        <!-- JUnit 5 (JUnit Jupiter) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Фаза resources в Maven сама копирует ресурсы из src/main/resources,
             Но чтобы использовать файл config.properties как фильтруемый,
             можно настроить resource-фильтрацию: -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
            <!-- Можно добавить внешние ресурсы, например config.properties из корня,
                 и тоже прогонять через фильтр, если нужно подставлять какие-то переменные. -->
            <resource>
                <directory>.</directory>
                <includes>
                    <include>config.properties</include>
                </includes>
                <filtering>true</filtering>
            </resource>
        </resources>

        <plugins>
            <!-- compile + Процессор аннотаций lombok и версия java -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.34</version>
                        </path>
                    </annotationProcessorPaths>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>

            <!-- build + test (package) -->
            <!-- для запуска просто build, без тестов: -->
            <!-- mvn package -DskipTests -Dmaven.test.skip=true -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.3.2</version>
            </plugin>

            <!-- clean -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>



            <!-- (Задача 5) Перемещение собранного проекта на сервер по SCP -->
            <!-- работает -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>wagon-maven-plugin</artifactId>
                <version>2.0.2</version>
                <executions>
                    <execution>
                        <id>scp-deploy</id>
                        <phase>install</phase>
                        <goals>
                            <goal>upload</goal>
                        </goals>
                        <configuration>
                            <serverId>helios</serverId>
                            <fromDir>${project.build.directory}/</fromDir>
                            <includes>${project.build.finalName}.war</includes>
                            <url>scp://s409411@helios.cs.ifmo.ru:2222/home/studs/s409411/zalupa</url>
                        </configuration>
                    </execution>
                </executions>
            </plugin>



            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <!-- Задача 6. native2ascii -->
                    <!-- работает -->
                    <execution>
                        <id>native2ascii</id>
                        <phase>process-resources</phase>
                        <configuration>
                            <target>
                                <delete dir="${project.build.directory}/resources/resources-native"/>
                                <mkdir dir="${project.build.directory}/resources/resources-native"/>
                                <native2ascii src="${project.basedir}/src/main/resources"
                                              dest="${project.build.directory}/resources/resources-native"
                                              includes="**/*.properties"
                                              encoding="ISO-8859-1"
                                              reverse="false"/>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>

                    <!-- Задача 8. xml -->
                    <!-- работает -->
                    <execution>
                        <id>validate-xml</id>
                        <phase>validate</phase>
                        <configuration>
                            <target>
                                <echo>gav gav</echo>
                                <xmlvalidate>
                                    <fileset dir="${project.basedir}/src/main/resources">
                                        <include name="**/*.xml"/>
                                    </fileset>
                                    <fileset dir="${project.basedir}/src/main/webapp">
                                        <include name="**/*.xml"/>
                                    </fileset>
                                    <attribute name="http://xml.org/sax/features/validation" value="true"/>
                                    <attribute name="http://apache.org/xml/features/validation/schema"  value="true"/>
                                    <attribute name="http://xml.org/sax/features/namespaces" value="true"/>
                                </xmlvalidate>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>

                    <!-- Задача 10. team -->
                    <!-- вроде работает -->
                    <execution>
                        <id>build-previous-revisions</id>
                        <phase>site</phase>
                        <configuration>
                            <target>
                                <echo>=== Получаем 2 предыдущие ревизии GIT ===</echo>
                                <exec executable="git">
                                    <arg value="stash"/>
                                </exec>

                                <exec executable="git">
                                    <arg value="checkout"/>
                                    <arg value="HEAD~1"/>
                                </exec>
                                <exec executable="mvn">
                                    <arg value="package"/>
                                </exec>
                                <copy file="${project.build.directory}/${project.build.finalName}.war"
                                      tofile="${project.build.directory}/${project.build.finalName}.rev1.war"/>
                                <!-- Аналогичные действия для второй ревизии -->
                                <exec executable="git">
                                    <arg value="checkout"/>
                                    <arg value="HEAD~1"/>
                                </exec>
                                <exec executable="mvn">
                                    <arg value="package"/>
                                </exec>
                                <copy file="${project.build.directory}/${project.build.finalName}.war"
                                      tofile="${project.build.directory}/${project.build.finalName}.rev2.war"/>

                                <!-- Возвращаемся на основную ветку -->
                                <exec executable="git">
                                    <arg value="checkout"/>
                                    <arg value="opi3"/>
                                </exec>
                                <!-- Упаковка в zip -->
                                <zip destfile="${project.build.directory}/team_builds.zip">
                                    <fileset dir="${project.build.directory}">
                                        <include name="*.rev1.war"/>
                                        <include name="*.rev2.war"/>
                                    </fileset>
                                </zip>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>

                    <!-- Задача 13. alt-->
                    <!-- создаёт альтернативную версию программы с измененными именами переменных и классов
                    и упаковывает её в war-архив. Для создания war-архива использует цель package. -->
                    <execution>
                        <id>alt</id>
                        <phase>verify</phase>
                        <configuration>
                            <target>
                                <!-- 1) Копируем исходники -->
                                <mkdir dir="${project.build.directory}/alt-src"/>
                                <copy todir="${project.build.directory}/alt-src">
                                    <fileset dir="src/main/java"/>
                                </copy>

                                <!-- 2) Замена имён в скопированных файлах -->
                                <replaceregexp flags="g" byline="true"
                                               match="${replace.regex.oldName}"
                                               replace="${replace.regex.newName}">
                                    <fileset dir="${project.build.directory}/alt-src">
                                        <include name="**/*.java"/>
                                    </fileset>
                                </replaceregexp>

                                <!-- 3) Определяем classpath из Maven‑зависимостей -->
                                <path id="alt.classpath">
                                    <path refid="maven.dependency.classpath"/>
                                </path>

                                <!-- 4) Компиляция альтернативной версии -->
                                <mkdir dir="${project.build.directory}/alt-classes"/>
                                <javac srcdir="${project.build.directory}/alt-src"
                                       destdir="${project.build.directory}/alt-classes"
                                       includeantruntime="false"
                                       source="17"
                                       target="17"
                                       classpathref="alt.classpath">
                                    <!-- Lombok-аннотации -->
                                    <compilerarg value="-processor"/>
                                    <compilerarg value="lombok.launch.AnnotationProcessorHider$AnnotationProcessor"/>
                                </javac>

                                <!-- 5) Пакуем alt‑WAR -->
                                <war destfile="${project.build.directory}/${project.build.finalName}-alt.war"
                                     webxml="src/main/webapp/WEB-INF/web.xml">
                                    <classes dir="${project.build.directory}/alt-classes"/>
                                    <fileset dir="src/main/webapp"/>
                                </war>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>

                    <!-- Задача 14. report-->
                    <!-- в случае успешного прохождения тестов сохраняет отчет junit в формате xml,
                    добавляет его в репозиторий git и выполняет commit. -->
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <configuration>
                            <target name="commit-junit-report">
                                <echo message="Adding JUnit report to git repository"/>
                                <exec executable="git">
                                    <arg value="add"/>
                                    <arg value="${project.build.directory}/surefire-reports"/>
                                    <arg value="--force"/>
                                </exec>
                                <exec executable="git">
                                    <arg value="commit"/>
                                    <arg value="-m"/>
                                    <arg value="Add JUnit report"/>
                                </exec>
                            </target>
                        </configuration>
                        <goals><goal>run</goal></goals>
                    </execution>
                    <!-- ========== 15. env (копирование в TomEE + запуск) ========== -->
                    <execution>
                        <id>env</id>
                        <!-- сработает сразу после package -->
<!--                        <phase>pre-integration-test</phase>-->
                        <goals>
                            <goal>run</goal>
                        </goals>

                        <configuration>
                            <target name="env">
                                <echo message="***** ENV: deploy to TomEE *****"/>

                                <!-- 1) Копируем WAR -->
                                <!-- overwrite="true" перезапишет старую версию, если она есть -->
                                <copy file="${project.build.directory}/${project.build.finalName}.war"
                                      todir="/opt/tomee/webapps"
                                      overwrite="true"/>

                                <!-- 3) Стартуем TomEE -->
                                <!--  run  — в переднем плане; Maven заблокируется, пока TomEE работает.
                                     Если нужно в фоне — замени  run  на  start  ИЛИ добавь spawn="true". -->
                                <exec executable="/opt/tomee/bin/catalina.sh" dir="/opt/tomee/bin">
                                    <arg value="run"/>
                                </exec>

                                <echo message="***** ENV started (TomEE is running) *****"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
                <!-- Чтобы maven.dependency.classpath был доступен -->
                <dependencies>
                    <dependency>
                        <groupId>org.apache.maven</groupId>
                        <artifactId>maven-artifact</artifactId>
                        <version>3.9.0</version>
                    </dependency>
                </dependencies>
            </plugin>


            <!-- Задача 7. Java doc
            -->
            <!-- внешне работает. TODO Костя, проверь -->

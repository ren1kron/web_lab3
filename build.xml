        </target>
        <target name="retrieve" depends="resolve" description="Загрузка зависимостей из Ivy в каталог lib">
            <ivy:retrieve pattern="lib/[artifact]-[revision]-[classifier].[ext]"/>
        </target>



        <!-- ========== compile ========== -->
        <target name="compile" description="Compiling source codes" depends="resolve">
            <path refid="classpath"/>
            <mkdir dir="${classes}/java/main"/>
            <mkdir dir="${classes}/java/test"/>
            <javac srcdir="${main.dir}"
                   destdir="${classes}/java/main"
                   includeantruntime="false"
                   classpathref="classpath">
                <compilerarg value="-processor"/>
                <compilerarg value="lombok.launch.AnnotationProcessorHider$AnnotationProcessor"/>
            </javac>
            <javac
                    srcdir="${test.dir}"
                    destdir="${classes}/java/test"
                    includeantruntime="false">
                <classpath>
                    <path refid="classpath"/>
                    <pathelement location="${classes}/java/main"/>
                </classpath>
            </javac>
            <echo message="PROJECT SUCK_SEX_FULLY COMPILED!!!"/>
        </target>

        <!-- ========== build ========== -->
        <target name="build" depends="compile,retrieve" description="Compilation and packaging into war">

<project name="web3" default="compile" basedir="."
         xmlns:ivy="antlib:org.apache.ivy.ant">

    <property file="build.properties"/>

<!--    <taskdef name="scp" classname="org.apache.tools.ant.taskdefs.optional.ssh.Scp"-->
<!--             classpathref="classpath"/>-->

    <!-- ivy -->
    <target name="resolve" description="resolve dependencies">
        <ivy:resolve/>
        <ivy:cachepath pathid="classpath" conf="compile, test"/>
    </target>

    <!-- ========== compile ========== -->
    <target name="compile" description="Compiling source codes" depends="resolve">
        <path refid="ivy.classpath"/>
        <mkdir dir="${classes}/java/main"/>
        <mkdir dir="${classes}/java/test"/>
        <javac srcdir="${main.dir}"
               destdir="${classes}/java/main"
               includeantruntime="false"
               classpathref="classpath">
            <compilerarg value="-processor"/>
            <compilerarg value="lombok.launch.AnnotationProcessorHider$AnnotationProcessor"/>
        </javac>
        <javac
                srcdir="${test.dir}"
                destdir="${classes}/java/test"
                includeantruntime="false">
            <classpath>
                <path refid="classpath"/>
                <pathelement location="${classes}/java/main"/>
            </classpath>
        </javac>
        <echo message="PROJECT SUCK_SEX_FULLY COMPILED!!!"/>
    </target>

    <!-- ========== build ========== -->
    <target name="build" depends="compile" description="Compilation and packaging into war">
        <mkdir dir="${libs}"/>
<!--        <jar destfile="${dist.dir}/${jar.name}" basedir="${classes}">-->
<!--            <manifest>-->
<!--                <attribute name="Implementation-Version" value="${project.version}"/>-->
<!--            </manifest>-->
<!--        </jar>-->
        <war destfile="${libs}/${war.name}" webxml="${web.dir}/WEB-INF/web.xml">
            <classes dir="${classes}"/>
            <fileset dir="${web.dir}"/>
        </war>
    </target>

    <!-- ========== clean ========== -->
    <target name="clean" description="Cleaning up compiled classes and temporary files">
        <delete dir="${build.dir}"/>
        <delete dir="${libs}"/>
    </target>

    <!-- ========== test ========== -->
    <target name="test" depends="build" description="Running junit-tests">
        <junit printsummary="on" haltonfailure="true" haltonerror="true">
            <classpath>
                <path refid="classpath"/>
                <pathelement location="${classes}/java/test"/>
            </classpath>
            <batchtest fork="yes" todir="${build.dir}/test-results">
                <formatter type="plain"/>
                <fileset dir="${test.dir}" includes="*Test.java"/>
            </batchtest>
        </junit>
    </target>

    <!-- ========== scp ========== -->
    <target name="scp" depends="build" description="Перемещение собранного проекта по SCP">
        
<!--        &lt;!&ndash; Нужно, чтобы Ant умел выполнять scp:-->
<!--             <taskdef name="scp" classname="org.apache.tools.ant.taskdefs.optional.ssh.Scp"/>-->
<!--             или использование <exec> со сторонними инструментами scp/pscp. &ndash;&gt;-->

        <classpath>

        </classpath>
        <!-- Пример через scp Ant (требует дополнительной настройки SSH Tasks for Ant):-->
        <scp file="${libs}/${war.name}"
             todir="${scp.user}@${scp.host}:${scp.remote.dir}"
             port="${scp.port}"
             trust="true"/>


        <!-- Пример через <exec> (если нет SSH-таска): -->
<!--        <exec executable="scp">-->
<!--            <arg value="-P"/>-->
<!--            <arg value="${scp.port}"/>-->
<!--            <arg value="${libs}/${war.name}"/>-->
<!--            <arg value="${scp.user}@${scp.host}:${scp.remote.dir}"/>-->
<!--        </exec>-->
    </target>

    <!-- ========== native2ascii ========== -->
    <target name="native2ascii" description="Converting localization files">
        <mkdir dir="${build.dir}/resources/resources-native"/>
        <native2ascii src="${resources.dir}"
                      dest="${build.dir}/resources/resources-native"
                      includes="**/*.properties"
                      encoding="UTF-8"
                      reverse="false"/>
    </target>

    <!-- ========== doc ========== -->
    <target name="doc" depends="build" description="Adding MD5 and SHA-1, generating javadoc">
        <!-- Расчёт MD5 и SHA-1 для jar -->
        <checksum file="${libs}/${war.name}"
                  property="war.checksum"
                  algorithm="MD5"/>
        <checksum file="${libs}/${war.name}"
                  property="war.sha1"
                  algorithm="SHA-1"/>

        <!-- Добавляем MD5 и SHA-1 в MANIFEST.MF -->
        <war destfile="${libs}/${war.name}" update="true">
            <manifest>
                <attribute name="MD5" value="${war.checksum}"/>
                <attribute name="SHA-1" value="${war.sha1}"/>
            </manifest>
        </war>

        <!-- Генерация javadoc -->
        <mkdir dir="${doc.dir}"/>
        <javadoc sourcepath="${main.dir}/java" destdir="${doc.dir}" classpathref="classpath" packagenames="org.ren1kron.**">
            <doctitle>${project.name} API</doctitle>
        </javadoc>

        <!-- Добавляем javadoc в архив -->
        <jar destfile="${libs}/${war.name}" update="true">
            <fileset dir="${doc.dir}"/>
        </jar>
    </target>

    <!-- ========== xml ========== -->
    <target name="xml" description="Validate all XML files in a project">
        <xmlvalidate>
            <fileset dir="${resources.dir}">
                <include name="**/*.xml"/>
            </fileset>
            <fileset dir="${main.dir}/webapp">
                <include name="**/*.xml"/>
            </fileset>
        </xmlvalidate>
    </target>

    <!-- ========== music ========== -->
    <target name="music" depends="build" description="Play music when build is complete">
        <condition property="isWindows">
            <os family="windows"/>
        </condition>
        <condition property="isMac">
            <os family="mac"/>
        </condition>

        <!-- Windows -->
        <exec executable="cmd" osfamily="windows" failonerror="false">
            <arg value="/c"/>
            <arg value="start"/>
            <arg value=""/>
            <arg value="${music.file}"/>
        </exec>

        <!-- macOS -->
        <exec executable="afplay" osfamily="mac" failonerror="false">
            <arg value="${music.file}"/>
        </exec>
    </target>

    <!-- ========== team ========== -->
    <target name="team" description="Получение 2 предыдущих ревизий из git, их сборка и упаковка в zip">
        <!-- Предполагаем, что локальный репозиторий уже клонирован.
             1) Получаем 2 предыдущие ревизии
             2) Собираем их (вызываем цель build)
             3) Упаковываем результат в zip
        -->
        <echo message="Получение 2 предыдущих ревизий из git..."/>
        <exec executable="git">
            <arg value="checkout"/>
            <arg value="HEAD~2"/> <!-- переходим на ревизию HEAD~2 -->
        </exec>

        <ant target="build"/>

        <copy file="${dist.dir}/${jar.name}" tofile="${dist.dir}/${jar.name}.rev2"/>

        <exec executable="git">
            <arg value="checkout"/>
            <arg value="HEAD@{1}"/> <!-- одна ревизия выше (HEAD~1) -->
        </exec>

        <ant target="build"/>

        <copy file="${dist.dir}/${jar.name}" tofile="${dist.dir}/${jar.name}.rev1"/>

        <exec executable="git">
            <arg value="checkout"/>
            <arg value="main"/> <!-- возвращаемся на основную ветку или нужную ветку -->
        </exec>

        <!-- Упаковываем обе собранные jar в zip -->
        <zip destfile="${dist.dir}/team_builds.zip">
            <fileset dir="${dist.dir}">
                <include name="*.rev1"/>
                <include name="*.rev2"/>
            </fileset>
        </zip>
    </target>

    <!-- ========== diff ========== -->
    <target name="diff" description="Проверка состояния рабочей копии и commit, если изменения не касаются критичных классов">
        <!-- 1) Проверяем, какие файлы изменены (git status или git diff) -->
        <exec executable="git">
            <arg value="diff"/>
            <arg value="--name-only"/>
            <arg value="HEAD"/>
            <!-- Сохраняем вывод в свойство -->
            <redirector outputproperty="git.diff.files"/>
        </exec>

        <!-- 2) Если в списке нет критичных классов (из build.properties: diff.critical.classes),
               то делаем commit. Иначе - пропускаем. -->
        <condition property="do.commit">
            <not>
                <contains string="${git.diff.files}" substring="${diff.critical.classes}"/>
            </not>
        </condition>

        <echo message="Изменённые файлы: ${git.diff.files}"/>

        <echo message="do.commit: ${do.commit}"/>

        <if condition="${do.commit}">
            <then>
                <echo message="Commit изменений..."/>
                <exec executable="git">
                    <arg value="commit"/>
                    <arg value="-a"/>
                    <arg value="-m"/>
                    <arg value="Автоматический commit"/>
                </exec>
                <exec executable="git">
                    <arg value="push"/>
                </exec>
            </then>
            <else>
                <echo message="Изменения затрагивают критичные классы. Commit пропущен."/>
            </else>
        </if>
    </target>

    <!-- ========== Цель: history ========== -->
    <target name="history" description="Откат к предыдущим ревизиям, пока не удастся скомпилировать проект">
        <echo message="Пытаемся собрать текущую версию..."/>

        <!-- Пробуем compile, если неудача - откатываемся -->
        <ant target="compile" failonerror="false" errorproperty="compile.failed"/>

        <if condition="${compile.failed}">
            <then>
                <echo message="Сборка не удалась. Переходим к предыдущей ревизии..."/>
                <exec executable="git">
                    <arg value="checkout"/>
                    <arg value="HEAD~1"/>
                </exec>

                <!-- Рекурсивный вызов той же цели history, пока не соберётся
                     или пока не достигнем самой первой ревизии -->
                <ant target="history"/>
            </then>
            <else>
                <echo message="Сборка прошла успешно на ревизии:"/>
                <exec executable="git">
                    <arg value="rev-parse"/>
                    <arg value="HEAD"/>
                    <redirector outputproperty="current.sha"/>
                </exec>
                <echo message="Текущая ревизия: ${current.sha}"/>

                <!-- Формируем файл с результатом diff между этой ревизией
                     и следующей, которая не собиралась -->
                <exec executable="git">
                    <arg value="show"/>
                    <arg value="${current.sha}~1..${current.sha}"/>
                    <redirector output="history_diff.txt"/>
                </exec>
            </else>
        </if>
    </target>

    <!-- ========== Цель: alt ========== -->
    <target name="alt" description="Создание альтернативной версии программы и упаковка в jar">
        <!-- Меняем имена классов, переменных и т.д. с помощью replace/replaceregexp -->
        <mkdir dir="${build.dir}/alt"/>

        <!-- Копируем исходники во временную папку для замены -->
        <copy todir="${build.dir}/alt">
            <fileset dir="${src.dir}">
                <include name="**/*.java"/>
            </fileset>
        </copy>

        <!-- Пример замены -->
        <replaceregexp flags="g"
                       match="${replace.regex.oldName}"
                       replace="${replace.regex.newName}">
            <fileset dir="${build.dir}/alt">
                <include name="**/*.java"/>
            </fileset>
        </replaceregexp>

        <!-- Теперь компилируем уже альтернативные файлы -->
        <javac srcdir="${build.dir}/alt"
               destdir="${build.dir}/alt-classes"
               includeantruntime="false"
               classpathref="classpath" />

        <!-- Упаковка альтернативной версии в jar, используя цель build (или повторяя её логику) -->
        <jar destfile="${dist.dir}/${project.name}-alt-${project.version}.jar" basedir="${build.dir}/alt-classes">
            <manifest>
                <attribute name="Main-Class" value="${main.class}"/>
                <attribute name="Implementation-Version" value="${project.version}-alt"/>
            </manifest>
        </jar>
    </target>

    <!-- ========== Цель: report ========== -->
    <target name="report" depends="test" description="Сохраняет JUnit-отчёт и делает commit в SVN">
        <!-- Если тесты прошли успешно, сохраняем XML-отчёт и добавляем в SVN -->
        <!-- Допустим, JUnit по умолчанию складывает отчёты в build/junit/ (или другой путь).
             Или нужно воспользоваться <formatter> в <junit> -->

        <copy todir="${build.dir}/junit-reports">
            <fileset dir="${build.dir}">
                <include name="TEST-*.xml"/>
            </fileset>
        </copy>

        <!-- Добавляем отчёт в SVN и коммитим -->
        <!-- Аналогично git, если у вас SVN: -->
        <exec executable="svn">
            <arg value="add"/>
            <arg value="${build.dir}/junit-reports"/>
            <arg value="--force"/>
        </exec>
        <exec executable="svn">
            <arg value="commit"/>
            <arg value="-m"/>
            <arg value="Добавление отчёта о тестах"/>
        </exec>
    </target>

    <!-- ========== Цель: env ========== -->
    <target name="env" description="Сборка и запуск программы в альтернативных окружениях">
        <!-- Предположим, есть несколько версий Java, и мы хотим прогнать программу под всеми -->
        <foreach list="${env.java.versions}" param="java.version" delimiter=",">
            <sequential>
                <echo message="Запуск под Java ${java.version} с опциями ${env.jvm.args}"/>
                <!-- Укажем путь к нужной java, например:
                     /usr/lib/jvm/java-${java.version}/bin/java
                     или, если действительно установлено несколько версий.
                -->
                <exec executable="/usr/lib/jvm/java-${java.version}/bin/java">
                    <arg line="${env.jvm.args}"/>
                    <arg value="-jar"/>
                    <arg value="${dist.dir}/${jar.name}"/>
                </exec>
            </sequential>
        </foreach>
    </target>



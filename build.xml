        <!-- ========== native2ascii ========== -->
        <!-- TODO я не понимаю, почему ru проперти постоянно заполняется "?" и как затестить работоспособность сделанных проперти. Но локализацию я добавил, она теперь работает -->
        <target name="native2ascii" description="Converting localization files">
            <mkdir dir="${build.dir}/resources/resources-native"/>
            <native2ascii src="${resources.dir}"
                          dest="${build.dir}/resources/resources-native"
                          includes="**/*.properties"
                          encoding="UTF-8"

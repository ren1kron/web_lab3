        <target name="report" depends="test" unless="test.failed" description="Saves the JUnit report and commits it to SVN">
            <mkdir dir="${junit-reports.dir}"/>

            <junitreport todir="reports">
                <fileset dir="reports">
                    <include name="TEST-*.xml"/>
                </fileset>
            </junitreport>

            <copy todir="${junit-reports.dir}">
                <fileset dir="${build.dir}">
                    <include name="TEST-*.xml"/>
                </fileset>
            </copy>

            <exec executable="svn">
                <arg value="add"/>
                <arg value="${junit-reports.dir}"/>
                <arg value="--force"/>
            </exec>
            <exec executable="svn">
                <arg value="commit"/>
                <arg value="-m"/>
                <arg value="Add test report"/>
            </exec>
        </target>

